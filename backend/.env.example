# Copy to backend/.env (gitignored). Keys stay on the server; the browser never sees them.
# A provider without a key shows as "no key" in the AI Assistant page. Offline needs no key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=~openai/gpt-sol-latest
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b:fastest

# Cloud API mode. Keep HANDOFF_CLOUD=0 locally; never enable hardware writes on Railway.
HANDOFF_CLOUD=0
HANDOFF_CORS_ORIGINS=
HANDOFF_PASSCODE=
HANDOFF_LIVE_POSITIONS=0

# Optional Supabase persistence (the `handoff` schema in the shared Resume Fit project).
# Leave empty to use local SQLite. When set there is no fallback: an outage returns 503.
# Session pooler URL (IPv4), using the least-privilege handoff_app role:
# SUPABASE_DB_URL=postgresql://handoff_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=
# Which API wrote each log row: local (laptop with the glove) or railway.
HANDOFF_INSTANCE=local
